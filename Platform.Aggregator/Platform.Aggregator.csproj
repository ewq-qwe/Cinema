<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Aggregator Pattern: паралельно опитує сервіси (Лаб. 06 — gRPC, Лаб. 05 — HTTP) і збирає одну відповідь -->
  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.1" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- Лаб. 06: ті самі .proto, що в сервісах, — лише клієнтська частина -->
  <ItemGroup>
    <Protobuf Include="..\Services\Booking\Booking.Api\Protos\booking.proto" GrpcServices="Client" Link="Protos\booking.proto" />
    <Protobuf Include="..\Services\Catalog\Catalog.Api\Protos\catalog.proto" GrpcServices="Client" Link="Protos\catalog.proto" />
    <Protobuf Include="..\Services\Reviews\Reviews.WebApi\Protos\reviews.proto" GrpcServices="Client" Link="Protos\reviews.proto" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Aggregator.Tests" />
  </ItemGroup>

</Project>
