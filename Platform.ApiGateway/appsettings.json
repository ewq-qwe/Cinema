{
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "reviews-movie-rating": {
        "ClusterId": "reviews",
        "Order": 2,
        "Match": { "Path": "/api/movies/{movieId}/rating" },
        "Metadata": { "Team": "reviews", "Version": "v1", "Note": "специфічніший за catalog-movies: /api/movies/* належить Каталогу, а рейтинг — сервісу відгуків" }
      },
      "booking-bookings": {
        "ClusterId": "booking",
        "Order": 10,
        "Match": { "Path": "/api/bookings/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "booking-sessions": {
        "ClusterId": "booking",
        "Order": 10,
        "Match": { "Path": "/api/sessions/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "booking-customers": {
        "ClusterId": "booking",
        "Order": 10,
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "catalog-movies": {
        "ClusterId": "catalog",
        "Order": 100,
        "Match": { "Path": "/api/movies/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "catalog-genres": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/genres/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "catalog-people": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/people/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "reviews-reviews": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-discussions": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "booking": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://booking-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  },
  "Services": {
    "booking-api": { "http": [ "http://localhost:5093" ] },
    "catalog-api": { "http": [ "http://localhost:5024" ] },
    "reviews-api": { "http": [ "http://localhost:5136" ] },
    "aggregator": { "http": [ "http://localhost:5110" ] }
  },
  "AllowedHosts": "*"
}
