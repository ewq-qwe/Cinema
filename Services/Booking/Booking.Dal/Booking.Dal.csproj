<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Booking.Domain\Booking.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- NU1902/NU1903: транзитивна System.Security.Cryptography.Pkcs 9.0.x від SqlClient — закріплено виправлену версію -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Лаб. 08: SQL-міграції схеми після Лаб. 01 (застосовує Migrations/SchemaMigrator під час старту) -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Booking.Dal.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
