<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain не посилається на жоден інший шар. MongoDB.Bson — лише тип ObjectId, без драйвера доступу до БД. -->
  <ItemGroup>
    <PackageReference Include="MongoDB.Bson" Version="3.13.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
